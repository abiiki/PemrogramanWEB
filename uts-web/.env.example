APP_NAME="Library System"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
# Base URL. Sesuaikan dengan cara aplikasi diakses.
# Kosongkan agar URL mengikuti alamat aplikasi saat ini.
BASE_URL=
