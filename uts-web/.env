APP_NAME="Library System"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
# Base URL. Sesuaikan dengan cara aplikasi diakses.
# PHP built-in server : http://localhost:8000
# XAMPP (via public) : http://localhost/inventory-mvc/public
# Virtual host : http://inventory-mvc.test
BASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_library
DB_USER=root
DB_PASS=
SESSION_IDLE_TIMEOUT=30
UPLOAD_MAX_MB=2
API_ALLOWED_ORIGIN=*
API_DEFAULT_LIMIT=10